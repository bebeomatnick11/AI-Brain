local function remember(category, text)
    if not text or text == "" then return end
    table.insert(Agent.Memory, {
        category = tostring(category or "general"),
        text = tostring(text),
        time = os.time()
    })
    while #Agent.Memory > CONFIG.Agent.MemoryLimit do
        table.remove(Agent.Memory, 1)
    end
end

local function memoryText(limit)
    local result = {}
    local start = math.max(1, #Agent.Memory - (limit or 40))
    for i = start, #Agent.Memory do
        local item = Agent.Memory[i]
        table.insert(result, "[" .. item.category .. "] " .. item.text)
    end
    return table.concat(result, "\n")
end

local function addInstruction(text)
    if not text or text == "" then return end
    table.insert(Agent.Instructions, tostring(text))
    remember("instruction", text)
end

