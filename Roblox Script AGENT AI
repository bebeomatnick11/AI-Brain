local function sendBrainRequest(path, payload)
    if not CONFIG.Remote.BrainRegistry or not CONFIG.Remote.BrainRegistry.Enabled or not HTTP then
        return false
    end

    local ok, encoded = pcall(function()
        return HttpService:JSONEncode(payload)
    end)
    if not ok then return false end

    local success = false
    pcall(function()
        local response = HTTP({
            Url = CONFIG.Remote.BaseURL .. path,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["X-Brain-Secret"] = CONFIG.Remote.BrainRegistry.Secret
            },
            Body = encoded
        })
        if response and tonumber(response.StatusCode) and response.StatusCode >= 200 and response.StatusCode < 300 then
            success = true
        end
    end)
    return success
end

local function getActiveSkillsList()
    local list = {}
    for name in pairs(Agent.Skills) do
        table.insert(list, name)
    end
    return list
end

local function registerBrain()
    local payload = {
        brainId = Agent.BrainId,
        userId = tostring(LocalPlayer.UserId),
        displayName = LocalPlayer.DisplayName,
        originalName = LocalPlayer.Name,
        createdAt = os.time() * 1000,
        brainVersion = "4.0",
        skills = getActiveSkillsList()
    }
    local ok = sendBrainRequest(CONFIG.Remote.BrainRegistry.RegisterPath, payload)
    if ok then
        remember("system", "Brain registered to Registry: " .. Agent.BrainId)
    end
    return ok
end

local function heartbeatBrain()
    local payload = {
        brainId = Agent.BrainId,
        status = "online",
        brainVersion = "4.0",
        activeSkills = getActiveSkillsList(),
        lastSeen = os.time() * 1000
    }
    sendBrainRequest(CONFIG.Remote.BrainRegistry.HeartbeatPath, payload)
end

