Agent.Root = getRoot(Agent.Character)

--============================================================
-- UTILITIES
--============================================================

local function destroy(object)

    if object then

        pcall(function()
            object:Destroy()
        end)

    end
end

local function clampText(text, max)

    text = tostring(text or "")

    if #text > max then
        return string.sub(text, 1, max) .. "..."
    end

    return text
end

local function dist(a, b)

    if not a or not b then
        return math.huge
    end

    return (a.Position - b.Position).Magnitude
end

local function normalize(text)

    text = tostring(text or "")

    text = string.lower(text)

    text = text:gsub("[%c]", " ")

    text = text:gsub("%s+", " ")

    text = text:gsub("^%s+", "")

    text = text:gsub("%s+$", "")

    return text
end

local function contains(text, list)

    for _, word in ipairs(list) do

        if string.find(text, word, 1, true) then
            return true
        end

    end

    return false
end

local function pick(list)

    if not list or #list == 0 then
        return ""
    end

    return list[math.random(1, #list)]
end

local function safeNumber(value, default)

    local n = tonumber(value)

    if n then
        return n
    end

    return default or 0
end

