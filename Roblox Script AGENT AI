        Color3.new(
            1,
            1,
            1
        )

    label.TextSize =
        12

    label.Font =
        Enum.Font.Gotham

    label.TextWrapped =
        true

    label.Parent =
        frame

    Agent.CurrentThought =
        text

    task.delay(
        duration,
        function()

            if bubble
                and bubble.Parent then

                destroy(bubble)

            end
        end
    )
end

