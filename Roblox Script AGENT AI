--============================================================
-- BRAIN REGISTRY
--============================================================

local function sendBrainRequest(
    path,
    payload
)

    if not CONFIG.Remote.BrainRegistry
        or not CONFIG.Remote.BrainRegistry.Enabled
        or not HTTP then

        return false
    end

    local ok, encoded =
        pcall(function()

            return HttpService:
                JSONEncode(
                    payload
                )

        end)

    if not ok then
        return false
    end

    local success =
        false

    pcall(function()

        local response =
            HTTP({

                Url =
                    CONFIG.Remote.BaseURL
                    ..
                    path,

                Method =
                    "POST",

                Headers = {

                    ["Content-Type"] =
                        "application/json",

                    ["X-Brain-Secret"] =
                        CONFIG.Remote.BrainRegistry.Secret
                },

                Body =
                    encoded
            })

        if response
            and tonumber(
                response.StatusCode
            )
            and response.StatusCode >= 200
            and response.StatusCode < 300 then

            success = true
        end
    end)

    return success
end

local function getActiveSkillsList()

    local list = {}

    for name in pairs(
        Agent.Skills
    ) do

        table.insert(
            list,
            name
        )
    end

    table.sort(list)

    return list
end

local function registerBrain()

    local payload = {

        brainId =
            Agent.BrainId,

        userId =
            tostring(
                LocalPlayer.UserId
            ),

        displayName =
            LocalPlayer.DisplayName,

        originalName =
            LocalPlayer.Name,

        createdAt =
            os.time() * 1000,

        brainVersion =
            "5.0",

        skills =
            getActiveSkillsList(),

        memoryCount =
            #Agent.Memory,

        learnedRuleCount =
            #Agent.LearnedRules
    }

    local ok =
        sendBrainRequest(
            CONFIG.Remote.BrainRegistry.RegisterPath,
            payload
        )

    if ok then

        remember(
            "system",
            "Brain registered: " ..
            Agent.BrainId,
            0.5
        )
    end

    return ok
end

local function heartbeatBrain()

    local payload = {

        brainId =
            Agent.BrainId,

        status =
            Agent.Alive
            and "online"
            or "offline",

        brainVersion =
            "5.0",

        activeSkills =
            getActiveSkillsList(),

        lastSeen =
            os.time() * 1000,

        intent =
            BrainState.LastIntent,

        action =
            Agent.CurrentAction,

        following =
            Agent.Following,

        memoryCount =
            #Agent.Memory,

        confidence =
            BrainState.Confidence
    }

    sendBrainRequest(
        CONFIG.Remote.BrainRegistry.HeartbeatPath,
        payload
    )
end

task.spawn(function()

    if not CONFIG.Remote.BrainRegistry
        or not CONFIG.Remote.BrainRegistry.Enabled then

        return
    end

    task.wait(2)

    registerBrain()

    while Agent.Alive do

        heartbeatBrain()

        task.wait(
            CONFIG.Remote.BrainRegistry.HeartbeatInterval
            or 25
        )
    end
end)

