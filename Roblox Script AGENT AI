local function createClone()
    if not Agent.Character then return end
    Agent.Character.Archivable = true

    local clone
    local ok = pcall(function()
        clone = Agent.Character:Clone()
    end)
    if not ok or not clone then return end

    clone.Name = "Astra_AI_Clone"

    for _, object in ipairs(clone:GetDescendants()) do
        if object:IsA("Script") or object:IsA("LocalScript") or object:IsA("ModuleScript") or object:IsA("Tool") then
            destroy(object)
        elseif object:IsA("BasePart") then
            object.CanCollide = false
            object.CanTouch = false
            object.Massless = true
        end
    end

    local humanoid = getHumanoid(clone)
    if humanoid then
        humanoid.DisplayName = CONFIG.Agent.Name
        humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
        humanoid.BreakJointsOnDeath = false
    end

    local root = getRoot(clone)
    if not root then
        destroy(clone)
        return
    end

    clone.Parent = Workspace
    Agent.Clone = clone
    Agent.CloneRoot = root
    Agent.CloneHumanoid = humanoid
end

createClone()

