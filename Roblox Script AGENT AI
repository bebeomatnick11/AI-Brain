-- WORLD SCANNER
--==================================================

local function scanWorld()
    if not Agent.Root then return end
    local result = {}
    local origin = Agent.Root.Position

    for _, player in ipairs(Players:GetPlayers()) do
        if player \~= LocalPlayer then
            local character = player.Character
            local root = getRoot(character)
            if root then
                local d = (root.Position - origin).Magnitude
                if d <= CONFIG.Agent.ScanDistance then
                    local humanoid = getHumanoid(character)
                    table.insert(result, {
                        type = "player",
                        name = player.Name,
                        displayName = player.DisplayName,
                        distance = math.floor(d),
                        health = humanoid and math.floor(humanoid.Health) or 0
                    })
                end
            end
        end
    end

    local parts, humanoids = 0, 0
    local ok, objects = pcall(function()
        return Workspace:GetPartBoundsInRadius(origin, CONFIG.Agent.ScanDistance)
    end)

    if ok and objects then
        for _, object in ipairs(objects) do
            if object:IsA("BasePart") then
                parts += 1
                local model = object:FindFirstAncestorOfClass("Model")
                if model and model:FindFirstChildOfClass("Humanoid") then
                    humanoids += 1
                end
            end
        end
    end

    table.insert(result, { type = "environment", parts = parts, humanoids = humanoids })
    Agent.Observations = result

    while #Agent.Observations > CONFIG.Agent.ObservationLimit do
        table.remove(Agent.Observations, 1)
    end
end

local function observationText()
    local result = {}
    for _, item in ipairs(Agent.Observations) do
        if item.type == "player" then
            table.insert(result, string.format("Player %s (%s): %dst, HP %d", item.name, item.displayName, item.distance, item.health))
        elseif item.type == "environment" then
            table.insert(result, string.format("Environment: %d parts, %d humanoid models", item.parts, item.humanoids))
        end
    end
    return table.concat(result, "\n")
end

