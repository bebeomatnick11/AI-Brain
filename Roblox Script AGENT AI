--============================================================
-- INTENT ENGINE
--============================================================

local function detectIntent(message)

    local t =
        normalize(message)

    if contains(
        t,
        {
            "theo anh",
            "follow",
            "đi theo",
            "theo tôi"
        }
    ) then
        return "follow"
    end

    if contains(
        t,
        {
            "dừng",
            "stop",
            "đứng yên",
            "ngừng theo"
        }
    ) then
        return "stop"
    end

    if contains(
        t,
        {
            "quét",
            "scan",
            "quan sát",
            "nhìn xung quanh",
            "có ai không"
        }
    ) then
        return "scan"
    end

    if contains(
        t,
        {
            "bạn là ai",
            "cậu là ai",
            "who are you",
            "giới thiệu"
        }
    ) then
        return "identity"
    end

    if contains(
        t,
        {
            "bạn làm được gì",
            "chức năng",
            "có thể làm gì",
            "help",
            "hướng dẫn"
        }
    ) then
        return "capabilities"
    end

    if contains(
        t,
        {
            "nhớ gì",
            "memory",
            "bạn nhớ",
            "đã nhớ"
        }
    ) then
        return "memory"
    end

    if contains(
        t,
        {
            "quên đi",
            "xóa nhớ",
            "reset memory",
            "xóa memory"
        }
    ) then
        return "reset_memory"
    end

    if contains(
        t,
        {
            "xin chào",
            "hello",
            "chào",
            "hi "
        }
    ) then
        return "greeting"
    end

    if contains(
        t,
        {
            "cảm ơn",
            "thanks",
            "thank you"
        }
    ) then
        return "thanks"
    end

    if contains(
        t,
        {
            "viết code",
            "code giúp",
            "script",
            "luau",
            "lập trình"
        }
    ) then
        return "code"
    end

    if contains(
        t,
        {
            "build",
            "xây",
            "tạo hệ thống",
            "thiết kế"
        }
    ) then
        return "build"
    end

    if contains(
        t,
        {
            "lỗi",
            "bug",
            "error",
            "sửa",
            "debug"
        }
    ) then
        return "debug"
    end

    if contains(
        t,
        {
            "phân tích",
            "analyze",
            "đánh giá"
        }
    ) then
        return "analyze"
    end

    if contains(
        t,
        {
            "kế hoạch",
            "plan",
            "lập kế hoạch"
        }
    ) then
        return "plan"
    end

    if contains(
        t,
        {
            "giải thích",
            "tại sao",
            "why",
            "là gì"
        }
    ) then
        return "explain"
    end

    if contains(
        t,
        {
            "profile",
            "trạng thái",
            "status",
            "brainid"
        }
    ) then
        return "status"
    end

    if string.find(
        t,
        "nhớ rằng",
        1,
        true
    ) then
        return "learn"
    end

    return "general"
end

