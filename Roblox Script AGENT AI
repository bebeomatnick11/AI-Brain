--============================================================
-- LEARNED RULES
--============================================================

local function learnRule(trigger, rule, confidence)

    trigger = tostring(trigger or "")

    rule = tostring(rule or "")

    if trigger == "" or rule == "" then
        return false
    end

    table.insert(
        Agent.LearnedRules,
        {

            trigger = normalize(trigger),

            rule = rule,

            confidence =
                math.clamp(
                    tonumber(confidence) or 0.8,
                    0,
                    1
                ),

            time = os.time()
        }
    )

    while #Agent.LearnedRules >
        CONFIG.Agent.LearnedRuleLimit do

        table.remove(
            Agent.LearnedRules,
            1
        )

    end

    remember(
        "learned_rule",
        trigger .. " -> " .. rule,
        0.9
    )

    return true
end

local function retrieveRules(message)

    local result = {}

    local lower =
        normalize(message)

    for _, rule in ipairs(Agent.LearnedRules) do

        if string.find(
            lower,
            rule.trigger,
            1,
            true
        ) then

            table.insert(
                result,
                rule
            )

        end
    end

    table.sort(
        result,
        function(a, b)
            return a.confidence > b.confidence
        end
    )

    return result
end

local function ruleText(message)

    local rules =
        retrieveRules(message)

    local result = {}

    for i = 1,
        math.min(
            #rules,
            CONFIG.Brain.MaxRetrievedRules
        ) do

        table.insert(
            result,
            rules[i].rule
        )

    end

    return table.concat(result, "\n")
end

