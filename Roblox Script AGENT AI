local function selectSkill(message)
    local lower = string.lower(message or "")
    local best, bestScore = nil, 0
    for name, skill in pairs(Agent.Skills) do
        local score = 0
        for _, trigger in ipairs(skill.Triggers) do
            if string.find(lower, string.lower(trigger), 1, true) then
                score += 1
            end
        end
        if score > bestScore then
            bestScore = score
            best = skill
        end
    end
    return best
end

