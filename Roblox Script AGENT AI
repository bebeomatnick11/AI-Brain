local function executeAction(
    action,
    data
)

    action =
        string.upper(
            tostring(action or "")
        )

    local fn =
        Actions[action]

    if not fn then

        return false,
            "Unknown action: " ..
            action
    end

    local ok, success, result =
        pcall(
            fn,
            data
        )

    if not ok then

        Agent.StateError =
            tostring(success)

        return false,
            "Action error."
    end

    Agent.CurrentAction =
        action

    BrainState.LastActionResult =
        result

    return success,
        result
end

--============================================================
-- PATHFINDING
--============================================================

function stopMovement()

    Agent.PathId += 1

    Agent.Moving = false

    Agent.CurrentGoal = nil

    if Agent.CloneHumanoid then

        pcall(function()

            Agent.CloneHumanoid:
                Move(Vector3.zero)

        end)
    end
end

local function teleportToPlayer()

    if not Agent.Root
        or not Agent.Clone then

        return
    end

    local target =
        Agent.Root.CFrame
        * CFrame.new(
            0,
            0,
            CONFIG.Agent.FollowDistance
        )

    pcall(function()

        Agent.Clone:
            PivotTo(target)

    end)
end

local function navigate(
    destination
)

    if not Agent.CloneRoot
        or not Agent.CloneHumanoid
        or not destination then

        return false
    end

    Agent.PathId += 1

    local pathId =
        Agent.PathId

    Agent.Moving = true

    Agent.CurrentGoal =
        destination

    local path

    local ok =
        pcall(function()

            path =
                PathfindingService:
                CreatePath({

                    AgentRadius =
                        CONFIG.Movement.AgentRadius,

                    AgentHeight =
                        CONFIG.Movement.AgentHeight,

                    AgentCanJump =
                        CONFIG.Movement.AgentCanJump,

                    AgentCanClimb =
                        CONFIG.Movement.AgentCanClimb,

                    WaypointSpacing =
                        CONFIG.Movement.WaypointSpacing
                })

            path:
                ComputeAsync(
                    Agent.CloneRoot.Position,
                    destination
                )
        end)

    if not ok
        or not path
        or path.Status ~=
            Enum.PathStatus.Success then

        Agent.Moving = false

        pcall(function()

            Agent.CloneHumanoid:
                MoveTo(destination)

        end)

        return false
    end

    local waypoints =
        path:GetWaypoints()

    for _, waypoint in ipairs(
        waypoints
    ) do

        if not Agent.Alive
            or pathId ~=
                Agent.PathId then

            break
        end

        if waypoint.Action ==
            Enum.PathWaypointAction.Jump then

            Agent.CloneHumanoid.Jump =
                true
        end

        pcall(function()

            Agent.CloneHumanoid:
                MoveTo(
                    waypoint.Position
                )

        end)

        local reached = false

        local connection =
            Agent.CloneHumanoid
            .MoveToFinished
            :Connect(function(success)

                reached = success

            end)

        local started =
            tick()

        while tick() - started < 2.5 do

            if not Agent.Alive
                or pathId ~=
                    Agent.PathId
                or not Agent.CloneRoot then

                break
            end

            if (
                Agent.CloneRoot.Position
                - waypoint.Position
            ).Magnitude < 3 then

                reached = true

                break
            end

            if reached then
                break
            end

            task.wait(0.08)
        end

        if connection then
            connection:Disconnect()
        end

        if not reached then
            break
        end
    end

    if pathId ==
        Agent.PathId then

        Agent.Moving = false

    end

    return true
end

local function follow()

    if not Agent.Root
        or not Agent.CloneRoot then

        return
    end

    local distance =
        dist(
            Agent.CloneRoot,
            Agent.Root
        )

    if distance >
        CONFIG.Agent.TeleportDistance then

        addEvent(
            "Astra quá xa người chơi và đang recover.",
            0.75
        )

        thoughtBubble(
            "Tôi đi hơi xa. Đang quay lại."
        )

        teleportToPlayer()

        return
    end

    if distance <=
        CONFIG.Agent.StopDistance then

        stopMovement()

        return
    end

    if tick() -
        Agent.LastPath <
        CONFIG.Movement.Recalculate then

        return
    end

    Agent.LastPath =
        tick()

    local target =
        Agent.Root.Position
        -
        Agent.Root.CFrame.LookVector
        *
        CONFIG.Agent.FollowDistance

    task.spawn(function()

        navigate(target)

    end)
end

--============================================================
-- CLONE
--============================================================

local function createClone()

    if not Agent.Character then
        return
    end

    Agent.Character.Archivable =
        true

    local clone

    local ok =
        pcall(function()

            clone =
                Agent.Character:Clone()

        end)

    if not ok or not clone then
        return
    end

    clone.Name =
        "Astra_AI_Clone"

    for _, object in ipairs(
        clone:GetDescendants()
    ) do

        if object:IsA("Script")
            or object:IsA("LocalScript")
            or object:IsA("ModuleScript")
            or object:IsA("Tool") then

            destroy(object)

        elseif object:IsA("BasePart") then

            object.CanCollide = false

            object.CanTouch = false

            object.Massless = true
        end
    end

    local humanoid =
        getHumanoid(clone)

    if humanoid then

        humanoid.DisplayName =
            CONFIG.Agent.Name

        humanoid.DisplayDistanceType =
            Enum.HumanoidDisplayDistanceType.Viewer

        humanoid.BreakJointsOnDeath =
            false
    end

    local root =
        getRoot(clone)

    if not root then

        destroy(clone)

        return
    end

    clone.Parent =
        Workspace

    Agent.Clone =
        clone

    Agent.CloneRoot =
        root

    Agent.CloneHumanoid =
        humanoid
end

