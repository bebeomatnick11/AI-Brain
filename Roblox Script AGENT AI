    if intent == "stop" then

        executeAction(
            "STOP"
        )

        BrainState.Confidence =
            0.99

        return pick({

            "Đã dừng.",

            "Ok, tôi đứng đây và quan sát.",

            "Ngừng follow."
        })
    end

