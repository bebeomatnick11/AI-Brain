--============================================================
-- DRAG
--============================================================

do

    local dragging = false

    local dragStart

    local startPos

    TitleBar.InputBegan:
        Connect(function(input)

            if input.UserInputType ==
                Enum.UserInputType.MouseButton1
                or
                input.UserInputType ==
                Enum.UserInputType.Touch then

                dragging = true

                dragStart =
                    input.Position

                startPos =
                    Main.Position

                input.Changed:
                    Connect(function()

                        if input.UserInputState ==
                            Enum.UserInputState.End then

                            dragging =
                                false
                        end
                    end)
            end
        end)

    UserInputService.InputChanged:
        Connect(function(input)

            if not dragging then
                return
            end

            if input.UserInputType ==
                Enum.UserInputType.MouseMovement
                or
                input.UserInputType ==
                Enum.UserInputType.Touch then

                local delta =
                    input.Position
                    -
                    dragStart

                Main.Position =
                    UDim2.new(

                        startPos.X.Scale,

                        startPos.X.Offset
                        + delta.X,

                        startPos.Y.Scale,

                        startPos.Y.Offset
                        + delta.Y
                    )
            end
        end)
end

