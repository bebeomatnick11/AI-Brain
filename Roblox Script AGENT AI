        end

        return
            "Quan sát hiện tại:\n" ..
            obs
    end

    -- IDENTITY

    if intent == "identity" then

        return
            "Tôi là " ..
            CONFIG.Agent.Name ..
            ". Tôi là Astra AI companion với Brain Core, memory, skills, planner, world model và khả năng tự hành động trong Roblox."
    end

    -- CAPABILITIES

    if intent == "capabilities" then

        return table.concat({

            "Tôi có:",

            "• Brain Core",

            "• Memory + retrieval",

            "• Learned rules",

            "• Skill system",

            "• Planner",

            "• World Model",

            "• Event detection",

            "• Follow + pathfinding",

            "• Local Brain",

            "• Remote Brain fallback"

        }, "\n")
    end

    -- MEMORY

    if intent == "memory" then

        if #Agent.Memory == 0 then

            return
                "Memory hiện đang trống."
        end

        return
            "Tôi đang giữ " ..
            tostring(
                #Agent.Memory
            ) ..
            " memory entries:\n\n" ..
            memoryText(12)
    end

    -- RESET

    if intent ==
        "reset_memory" then

        table.clear(
            Agent.Memory
        )

        table.clear(
            Agent.Conversation
        )

        table.clear(
            Agent.Events
        )

        BrainState.LastTopic =
            nil

        return
            "Đã xóa memory và conversation."
    end

    -- GREETING

    if intent ==
        "greeting" then

        return pick({

            "Chào anh.",

            "Hey, tôi online.",

            "Chào anh. Astra đang sẵn sàng."
        })
    end

    -- THANKS

    if intent ==
        "thanks" then

        return pick({

            "Không có gì.",

            "Ok.",

            "Cứ bảo nếu anh cần thêm."
        })
    end

    -- STATUS

    if intent ==
        "status" then

        return
            profileText()
    end

    -- LEARNING

    if string.find(
        lower,
        "nhớ rằng",
        1,
        true
    ) then

        local rule =
            message:gsub(
                "^[Nn]hớ rằng%s*",
                ""
            )

        learnRule(
            "nhớ rằng",
            rule,
            0.95
        )

        return
            "Đã ghi nhận điều đó vào learned rules."
    end

    -- CREATE PLAN

    if intent ==
        "plan"
        and CONFIG.Brain.EnablePlanning then

        local plan =
            createPlan(message)

        return
            "Tôi đã tạo kế hoạch:\n\n" ..
            planText()
    end

    -- SKILL

    local skill,
        skillScore =
        selectSkill(message)

    if skill then

        local retrieved =
            retrievedMemoryText(
                message
            )

        local rules =
            ruleText(
                message
            )

        local executionMessage =
            ""

        if skill.Execute then

            local ok, result =
                pcall(
                    skill.Execute,
                    {

                        message =
                            message,

                        intent =
                            intent,

                        memory =
                            retrieved,

                        rules =
                            rules,

                        world =
                            World,

                        agent =
                            Agent
                    }
                )

            if ok
                and type(result)
                    == "table" then

                executionMessage =
                    tostring(
                        result.message
                        or ""
                    )
            end
        end

        remember(
            "skill",
            "Used skill: " ..
            skill.Name,
            0.65
        )

        BrainState.Confidence =
            math.clamp(
                0.55 +
                skillScore * 0.1,
                0,
                1
            )

        if skill.Name ==
            "observe" then

            return
                "Tôi đã quan sát:\n" ..
                observationText()
        end

        if executionMessage ~= "" then

            return
                executionMessage
        end

        return
            "Tôi sẽ xử lý bằng skill \"" ..
            skill.Name ..
            "\".\n\n" ..
            skill.Instructions
    end

    -- WHY

    if contains(
        lower,
        {
            "tại sao",
            "vì sao",
            "why"
        }
    ) then

        BrainState.Confidence =
            0.45

        return
            "Tôi cần thêm ngữ cảnh để trả lời chính xác. Tôi không muốn tự bịa nguyên nhân khi chưa có đủ dữ liệu."
    end

    -- HOW

    if contains(
        lower,
        {
            "làm sao",
            "cách nào",
            "how to"
        }
    ) then

        return
            "Tôi có thể lập kế hoạch cho việc này. Anh muốn tôi tập trung vào cách làm nhanh hay cách làm ổn định?"
    end

    -- MEMORY CONTEXT

    local memories =
        retrieveMemories(
            message
        )

    if #memories > 0 then

        BrainState.Confidence =
            0.65

        local latest =
            memories[1]

        if latest then

            return
                "Tôi nhớ một phần liên quan: " ..
                clampText(
                    latest.text,
                    180
                ) ..
                "\n\nAnh muốn tôi tiếp tục từ đó hay xử lý theo hướng mới?"
        end
    end

    -- GENERAL

    BrainState.Confidence =
        0.35

    return pick({

        "Tôi hiểu hướng anh nói, nhưng cần thêm một chút context để xử lý chính xác.",

        "Ok. Tôi đang giữ ngữ cảnh hiện tại. Anh muốn tôi thực hiện bước nào?",

        "Tôi chưa muốn đoán bừa. Anh cho tôi thêm chi tiết nhé.",

        "Được. Tôi có thể phân tích, lập plan hoặc thực hiện action tùy yêu cầu."
    })
end

--============================================================
-- REMOTE RESPONSE PARSER
--============================================================

local function extractResponse(
    data
)

    if type(data) ~= "table" then
        return nil
    end

    local candidates = {

        data.response,

        data.answer,

        data.reply,

        data.content,

        data.text
    }

    for _, value in ipairs(
        candidates
    ) do

        if type(value)
            == "string"
            and #value > 0 then

            return value
        end
    end

    if type(data.message)
        == "string" then

        return data.message
    end

    if type(data.message)
        == "table"
        and type(
            data.message.content
        ) == "string" then

        return data.message.content
    end

    if type(data.choices)
        == "table"
        and data.choices[1] then

        local choice =
            data.choices[1]

        if type(
            choice.message
        ) == "table"
        and type(
            choice.message.content
        ) == "string" then

            return
                choice.message.content
        end

        if type(choice.text)
            == "string" then

            return choice.text
        end
    end

    return nil
end

--============================================================
-- BUILD REMOTE PROMPT
--============================================================

local function buildPrompt(
    message
)

    local skill =
        selectSkill(message)

    local skillText =
        ""

    if skill then

        skillText =
            "\nACTIVE SKILL:\n" ..
            skill.Name ..
            "\n" ..
            skill.Instructions
    end

    local instructions =
        table.concat(
            Agent.Instructions,
            "\n"
        )

    local retrieved =
        retrievedMemoryText(
            message
        )

    local rules =
        ruleText(
            message
        )

    local events =
        recentEventsText()

    local prompt = table.concat({

        "You are Astra, an adaptive AI companion inside Roblox.",

        "",

        "IMPORTANT BEHAVIOR:",

        "Do not claim actions happened unless they actually happened.",

        "Do not invent world entities.",

        "Use memory only when relevant.",

        "If uncertain, say so.",

        "Prefer concise natural responses.",

        "",

        "IDENTITY:",

        CONFIG.Agent.Name,

        "",

        "LANGUAGE:",

        CONFIG.Agent.Language,

        "",

        "PERSONALITY:",

        CONFIG.Agent.Personality,

        "",

        "STYLE:",

        CONFIG.Agent.Style,

        "",

        "PERSONAL INSTRUCTIONS:",

        instructions,

        "",

        "LEARNED RULES:",

        rules,

        "",

        "ACTIVE SKILL:",

        skillText,

        "",

        "WORLD OBSERVATIONS:",

        observationText(),

        "",

        "RECENT EVENTS:",

        events,

        "",

        "RELEVANT MEMORY:",

        retrieved,

        "",

        "RECENT CONVERSATION:"
    }, "\n")

    for _, item in ipairs(
        Agent.Conversation
    ) do

        prompt =
            prompt ..
            "\n" ..
            tostring(
                item.role
            ) ..
            ": " ..
            tostring(
                item.content
            )
    end

    prompt =
        prompt ..
        "\n\nUSER:\n" ..
        message

    if #prompt >
        CONFIG.Remote.MaxContext then

        prompt =
            string.sub(
                prompt,
                #prompt -
                CONFIG.Remote.MaxContext +
                1
            )
    end

    return prompt
end

--============================================================
-- REMOTE BRAIN
--============================================================

local function remoteBrain(
    message
)

    if not CONFIG.Remote.Enabled
        or not CONFIG.Brain.EnableRemote
        or not HTTP then

        return nil
    end

    if tick() -
        Agent.LastRemote <
        1 then

        return nil
    end

    if Agent.RemoteFailures > 0
        and tick() -
        Agent.LastRemoteFailure <
        CONFIG.Remote.RetryCooldown then

        return nil
    end

    Agent.LastRemote =
        tick()

    local prompt =
        buildPrompt(message)

    local body = {

        message =
            prompt,

        prompt =
            prompt,

        user =
            LocalPlayer.Name,

        userId =
            tostring(
                LocalPlayer.UserId
            ),

        brainId =
            Agent.BrainId,

        system =
            "Astra Adaptive AI Agent",

        conversation =
            Agent.Conversation,

        world =
            Agent.Observations
    }

    local encoded

    local encodedOK =
        pcall(function()

            encoded =
                HttpService:
                JSONEncode(body)

        end)

    if not encodedOK then
        return nil
    end

    for _, endpoint in ipairs(
        CONFIG.Remote.Endpoints
    ) do

        local response

        local ok =
            pcall(function()

                response =
                    HTTP({

                        Url =
                            CONFIG.Remote.BaseURL
                            ..
                            endpoint,

                        Method =
                            "POST",

                        Headers = {

                            ["Content-Type"] =
                                "application/json"
                        },

                        Body =
                            encoded
                    })

            end)

        if ok
            and type(response)
                == "table"
            and tonumber(
                response.StatusCode
            )
            and response.StatusCode >= 200
            and response.StatusCode < 300 then

            local data

            local decodeOK =
                pcall(function()

                    data =
                        HttpService:
                        JSONDecode(
                            response.Body
                        )

                end)

            if decodeOK then

                local result =
                    extractResponse(
                        data
                    )

                if result
                    and #result > 0 then

                    Agent.RemoteAvailable =
                        true

                    Agent.RemoteFailures =
                        0

                    return result
                end
            end
        end
    end

    Agent.RemoteAvailable =
        false

    Agent.RemoteFailures += 1

    Agent.LastRemoteFailure =
        tick()

    return nil
end

--============================================================
-- CONVERSATION
--============================================================

local function addConversation(
    role,
    content
)

    table.insert(
        Agent.Conversation,
        {

            role = role,

            content =
                tostring(content)
        }
    )

    while #Agent.Conversation >
        CONFIG.Agent.ConversationLimit do

        table.remove(
            Agent.Conversation,
            1
        )
    end
end

--============================================================
-- RESPONSE PIPELINE
--============================================================

local function respond(
    message
)

    if Agent.BrainBusy then
        return
    end

    Agent.BrainBusy =
        true

    BrainState.Thinking =
        true

    addMessage(
        "Anh",
        message,
        Color3.fromRGB(
            220,
            220,
            220
        )
    )

    addConversation(
        "user",
        message
    )

    task.spawn(function()

        local response

        -- COMMAND FIRST

        response =
            command(message)

        -- REMOTE SECOND

        if not response then

            response =
                remoteBrain(
                    message
                )
        end

        -- LOCAL FALLBACK

        if not response then

            response =
                localBrain(
                    message
                )
        end

        if not response then

            response =
                "Tôi chưa có đủ dữ liệu để xử lý yêu cầu này."
        end

        addConversation(
            "assistant",
            response
        )

        BrainState.LastResponse =
            response

        remember(
            "conversation",
            "User: " ..
            clampText(
                message,
                140
            ),
            0.35
        )

        remember(
            "conversation",
            "AI: " ..
            clampText(
                response,
                180
            ),
            0.35
        )

        addMessage(
            CONFIG.Agent.Name,
            response,
            Color3.fromRGB(
                120,
                180,
                255
            )
        )

        thoughtBubble(
            response
        )

        BrainState.Thinking =
            false

        Agent.BrainBusy =
            false
    end)
end

