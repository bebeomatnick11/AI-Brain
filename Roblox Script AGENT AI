)

    if not message
        or message == "" then

        return
            "Anh nói gì đi."
    end

    BrainState.Turn += 1

    BrainState.LastUserMessage =
        message

    local intent =
        detectIntent(message)

    BrainState.LastIntent =
        intent

    local lower =
        normalize(message)

    -- FOLLOW

    if intent == "follow" then

        executeAction(
            "FOLLOW"
        )

        BrainState.Confidence =
            0.98

        return pick({

            "Được. Tôi sẽ theo anh.",

            "Ok, follow đã bật. Tôi tự tìm đường.",

            "Được. Anh đi trước, tôi theo sau."
