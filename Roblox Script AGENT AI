        end
        return "Khoảng cách hiện tại ổn."
    end,
    function()
        if #Agent.Memory > 20 then
            return "Tôi đã tích lũy khá nhiều thông tin trong session này."
        end
        return "Tôi vẫn đang xây dựng model về môi trường hiện tại."
    end
}

local function think()
    if Agent.BrainBusy then return end
    if tick() - Agent.LastThought < CONFIG.Agent.ThoughtInterval then return end
    Agent.LastThought = tick()
    if math.random() > CONFIG.Agent.Initiative then return end

    local fn = thoughts[math.random(1, #thoughts)]
    local result = fn()
    remember("thought", result)
    thoughtBubble(result)
end

