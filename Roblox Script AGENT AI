--============================================================

function addEvent(text, importance)

    if not text or text == "" then
        return
    end

    table.insert(
        Agent.Events,
        {

            text = text,

            importance =
                importance or 0.6,

            time = os.time()
        }
    )

    while #Agent.Events >
        CONFIG.Agent.EventLimit do

        table.remove(
            Agent.Events,
            1
        )

    end

    remember(
        "event",
        text,
        importance or 0.6
    )
end

function detectWorldChanges(
    oldData,
    newData
)

    local oldPlayers = {}

    local newPlayers = {}

    for _, item in ipairs(
        oldData or {}
    ) do

        if item.type == "player" then
            oldPlayers[item.name] = item
        end
    end

    for _, item in ipairs(
        newData or {}
    ) do

        if item.type == "player" then
            newPlayers[item.name] = item
        end
    end

    for name, item in pairs(
        newPlayers
    ) do

        if not oldPlayers[name] then

            addEvent(
                "Player " ..
                name ..
                " xuất hiện trong vùng quan sát.",
                0.65
            )

        end
    end

    for name in pairs(
        oldPlayers
    ) do

        if not newPlayers[name] then

            addEvent(
                "Player " ..
                name ..
                " rời vùng quan sát.",
                0.55
            )

        end
    end
end

local function recentEventsText()

    local result = {}

    local startIndex =
        math.max(
            1,
            #Agent.Events
                - CONFIG.Brain.MaxRecentEvents
                + 1
        )

    for i = startIndex,
        #Agent.Events do

        local event =
            Agent.Events[i]

        table.insert(
            result,
            event.text
        )
    end

    return table.concat(
        result,
        "\n"
    )
end

