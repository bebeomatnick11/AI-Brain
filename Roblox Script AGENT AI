local function createCustomSkill(
    name,
    description,
    instructions
)

    name =
        string.lower(
            tostring(name or "")
        )

    if name == "" then
        return false
    end

    registerSkill(

        name,

        description
            or "Custom skill",

        {},

        instructions
            or description
            or "",

        function(context)

            return {

                success = true,

                message =
                    "Custom skill " ..
                    name ..
                    " executed."

            }

        end
    )

    remember(
        "skill",
        "Created skill: " ..
            name,
        0.8
    )

    return true
end

local function command(message)

    if string.sub(
        message,
        1,
        1
    ) ~= "/" then

        return nil
    end

    local args = {}

    for word in string.gmatch(
        message,
        "%S+"
    ) do

        table.insert(
            args,
            word
        )
    end

    local cmd =
        string.lower(
            args[1] or ""
        )

    if cmd == "/language" then

        return setLanguage(
            table.concat(
                args,
                " ",
                2
            )
        )
    end

    if cmd == "/personality" then

        return setPersonality(
            table.concat(
                args,
                " ",
                2
            )
        )
    end

    if cmd == "/style" then

        return setStyle(
            table.concat(
                args,
                " ",
                2
            )
        )
    end

    if cmd == "/instruction"
        or cmd == "/instructions" then

        local text =
            table.concat(
                args,
                " ",
                2
            )

        addInstruction(text)

        return
            "Đã thêm instruction."
    end

    if cmd == "/profile"
        or cmd == "/brain" then

        return profileText()
    end

    if cmd == "/memory" then

        return
            memoryText(60)
    end

    if cmd == "/world" then

        scanWorld()

        return
            observationText()
    end

    if cmd == "/events" then

        return
            recentEventsText()
    end

    if cmd == "/plan" then

        if args[2] then

            local goal =
                table.concat(
                    args,
                    " ",
                    2
                )

            createPlan(goal)

        end

        return
            planText()
    end

    if cmd == "/follow" then

        executeAction(
            "FOLLOW"
        )

        return
            "Đã bật follow."
    end

    if cmd == "/stop" then

        executeAction(
            "STOP"
        )

        return
            "Đã dừng follow."
    end

    if cmd == "/scan" then

        executeAction(
            "SCAN"
        )

        return
            observationText()
    end

    if cmd == "/reset" then

        table.clear(
            Agent.Memory
        )

        table.clear(
            Agent.Conversation
        )

        table.clear(
            Agent.Events
        )

        table.clear(
            Agent.LearnedRules
        )

        BrainState.LastTopic =
            nil

        Agent.CurrentPlan =
            nil

        return
            "Đã reset memory, events, rules và conversation."
    end

    if cmd == "/brainid" then

        return
            "BrainId: " ..
            tostring(
                Agent.BrainId
            )
    end

    if cmd == "/learn" then

        local trigger =
            args[2]

        local rule =
            table.concat(
                args,
                " ",
                3
            )

        if not trigger
            or rule == "" then

            return
                "Dùng: /learn trigger rule"
        end

        learnRule(
            trigger,
            rule,
            0.9
        )

        return
            "Đã học rule: " ..
            trigger ..
            " → " ..
            rule
    end

    if cmd == "/rules" then

        local result = {}

        for _, rule in ipairs(
            Agent.LearnedRules
        ) do

            table.insert(
                result,

                rule.trigger ..
                " → " ..
                rule.rule ..
                " [" ..
                string.format(
                    "%.2f",
                    rule.confidence
                ) ..
                "]"
            )
        end

        if #result == 0 then
            return "Chưa có learned rules."
        end

        return table.concat(
            result,
            "\n"
        )
    end

    if cmd == "/skills"
        or cmd == "/skill" then

        if not args[2]
            or args[2] == "list" then

            local list = {}

            for name, skill in pairs(
                Agent.Skills
            ) do

                table.insert(
                    list,
                    name ..
                    " — " ..
                    skill.Description
                )
            end

            table.sort(list)

            return table.concat(
                list,
                "\n"
            )
        end

        if args[2] == "use" then

            local skill =
                Agent.Skills[
                    string.lower(
                        args[3] or ""
                    )
                ]

            if not skill then

                return
                    "Không tìm thấy skill."
            end

            local result

            if skill.Execute then

                local ok, data =
                    pcall(
                        skill.Execute,
                        {
                            message = message,
                            agent = Agent
                        }
                    )

                if ok then
                    result = data
                end
            end

            return
                "Skill: " ..
                skill.Name ..
                "\n\n" ..
                skill.Instructions ..
                (
                    result
                    and
                    "\n\n" ..
                    tostring(
                        result.message
                        or ""
                    )
                    or ""
                )
        end

        if args[2] == "create" then

            local name =
                args[3]

            local description =
                table.concat(
                    args,
                    " ",
                    4
                )

            if not name then

                return
                    "Dùng: /skill create ten mo-ta"
            end

            createCustomSkill(
                name,
                description,
                description
            )

            return
                "Đã tạo skill: " ..
                name
        end
    end

    return
        "Command không tồn tại."
end

