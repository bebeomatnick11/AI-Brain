-- PLANNER
--============================================================

local function createPlan(goal)

    goal =
        tostring(goal or "")

    if goal == "" then
        return nil
    end

    local intent =
        detectIntent(goal)

    local steps = {}

    if intent == "follow" then

        steps = {

            "Xác định vị trí người chơi",

            "Kiểm tra khoảng cách",

            "Tính vị trí follow",

            "Tìm đường",

            "Di chuyển",

            "Kiểm tra kết quả"
        }

    elseif intent == "scan" then

        steps = {

            "Quét player",

            "Quét environment",

            "So sánh thay đổi",

            "Cập nhật World Model",

            "Báo cáo"
        }

    elseif intent == "build"
        or intent == "code" then

        steps = {

            "Phân tích yêu cầu",

            "Xác định thành phần",

            "Lập cấu trúc",

            "Kiểm tra logic",

            "Tạo kết quả",

            "Kiểm tra lại"
        }

    else

        steps = {

            "Hiểu mục tiêu",

            "Lấy context",

            "Kiểm tra memory",

            "Chọn skill",

            "Thực hiện",

            "Đánh giá kết quả"
        }
    end

    Agent.CurrentPlan = {

        goal = goal,

        intent = intent,

        steps = steps,

        current = 1,

        status = "active",

        created = os.time()
    }

    return Agent.CurrentPlan
end

local function planText()

    local plan =
        Agent.CurrentPlan

    if not plan then
        return "Hiện không có plan."
    end

    local result = {

        "GOAL: " ..
            plan.goal,

        "INTENT: " ..
            plan.intent,

        "STATUS: " ..
            plan.status,

        "STEP: " ..
            tostring(plan.current)
            .. "/" ..
            tostring(#plan.steps)
    }

    for i, step in ipairs(
        plan.steps
    ) do

        table.insert(
            result,
            tostring(i) ..
            ". " ..
            step
        )
    end

    return table.concat(
        result,
        "\n"
    )
end

