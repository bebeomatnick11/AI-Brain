--============================================================
-- WORLD SCANNER
--============================================================

function scanWorld()

    if not Agent.Root then
        return
    end

    local result = {}

    local origin =
        Agent.Root.Position

    -- PLAYERS

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then

            local character =
                player.Character

            local root =
                getRoot(character)

            if root then

                local distance =
                    (
                        root.Position
                        - origin
                    ).Magnitude

                if distance <=
                    CONFIG.Agent.ScanDistance then

                    local humanoid =
                        getHumanoid(character)

                    table.insert(
                        result,
                        {

                            type = "player",

                            name =
                                player.Name,

                            displayName =
                                player.DisplayName,

                            distance =
                                math.floor(
                                    distance
                                ),

                            health =
                                humanoid
                                and math.floor(
                                    humanoid.Health
                                )
                                or 0
                        }
                    )
                end
            end
        end
    end

    -- WORLD PARTS

    local parts = 0

    local humanoids = 0

    local ok, objects =
        pcall(function()

            return Workspace:
                GetPartBoundsInRadius(
                    origin,
                    CONFIG.Agent.ScanDistance
                )

        end)

    if ok and objects then

        for i, object in ipairs(objects) do

            if i >
                CONFIG.World.MaxParts then

                break
            end

            if object:IsA("BasePart") then

                parts += 1

                local model =
                    object:
                    FindFirstAncestorOfClass(
                        "Model"
                    )

                if model and
                    model:FindFirstChildOfClass(
                        "Humanoid"
                    ) then

                    humanoids += 1

                end
            end
        end
    end

    table.insert(
        result,
        {

            type = "environment",

            parts = parts,

            humanoids = humanoids
        }
    )

    -- CHANGE DETECTION

    Agent.PreviousObservations =
        Agent.Observations

    Agent.Observations = result

    World.Players = {}

    for _, item in ipairs(result) do

        if item.type == "player" then

            World.Players[item.name] =
                item

        end
    end

    World.Environment = {

        Parts = parts,

        Humanoids = humanoids
    }

    World.LastUpdate = os.time()

    if CONFIG.Brain.EnableEventMemory then

        detectWorldChanges(
            Agent.PreviousObservations,
            Agent.Observations
        )

    end
end

