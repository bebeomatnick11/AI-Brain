        Agent.Clone:
        FindFirstChild("Head")
        or Agent.CloneRoot

    if not head then
        return
    end

    local old =
        head:FindFirstChild(
            "AstraThought"
        )

    if old then
        destroy(old)
    end

    text =
        clampText(
            text,
            220
        )

    duration =
        duration
        or math.clamp(
            2 + (#text / 17),
            2,
            14
        )

    local bubble =
        Instance.new(
            "BillboardGui"
        )

    bubble.Name =
        "AstraThought"

    bubble.Adornee =
        head

    bubble.Size =
        UDim2.fromOffset(
            280,
            80
        )

    bubble.StudsOffset =
        Vector3.new(
            0,
            3.2,
            0
        )

    bubble.AlwaysOnTop =
        true

    bubble.MaxDistance =
        100

    bubble.Parent =
        head

    local frame =
        Instance.new("Frame")

    frame.Size =
        UDim2.fromScale(
            1,
            1
        )

    frame.BackgroundColor3 =
        Color3.fromRGB(
            20,
            20,
            27
        )

    frame.BackgroundTransparency =
        0.1

    frame.Parent =
        bubble

    local corner =
        Instance.new(
            "UICorner"
        )

    corner.CornerRadius =
        UDim.new(
            0,
            10
        )

    corner.Parent =
        frame

    local label =
        Instance.new(
            "TextLabel"
        )

    label.Size =
        UDim2.new(
            1,
            -12,
            1,
            -8
        )

    label.Position =
        UDim2.fromOffset(
            6,
            4
        )

    label.BackgroundTransparency =
        1

    label.Text =
        "💭 " .. text

