local function remember(category, text, importance, metadata)

    if not text or tostring(text) == "" then
        return
    end

    table.insert(Agent.Memory, {

        id = HttpService:GenerateGUID(false),

        category = tostring(category or "general"),

        text = tostring(text),

        importance = math.clamp(
            tonumber(importance) or 0.5,
            0,
            1
        ),

        metadata = metadata or {},

        time = os.time()
    })

    while #Agent.Memory > CONFIG.Agent.MemoryLimit do
        table.remove(Agent.Memory, 1)
    end
end

local function memoryText(limit)

    local result = {}

    local startIndex =
        math.max(
            1,
            #Agent.Memory - (limit or 40) + 1
        )

    for i = startIndex, #Agent.Memory do

        local item = Agent.Memory[i]

        table.insert(
            result,
            string.format(
                "[%s | %.2f] %s",
                item.category,
                item.importance or 0.5,
                item.text
            )
        )

    end

    return table.concat(result, "\n")
end

--============================================================
-- MEMORY RETRIEVAL
--============================================================

local function tokenScore(query, text)

    query = normalize(query)

    text = normalize(text)

    if query == "" or text == "" then
        return 0
    end

    local score = 0

    for token in string.gmatch(query, "%S+") do

        if #token >= 3 then

            if string.find(text, token, 1, true) then
                score += 1
            end

        end

    end

    return score
end

local function retrieveMemories(query)

    local scored = {}

    for _, item in ipairs(Agent.Memory) do

        local relevance =
            tokenScore(query, item.text)

        local importance =
            item.importance or 0.5

        local age =
            math.max(
                0,
                os.time() - (item.time or os.time())
            )

        local freshness =
            math.max(
                0,
                1 - (age / 604800)
            )

        local score =
            relevance * 0.55
            + importance * 0.30
            + freshness * 0.15

        if score >= CONFIG.Brain.MinimumMemoryScore then

            table.insert(
                scored,
                {
                    item = item,
                    score = score
                }
            )

        end
    end

    table.sort(
        scored,
        function(a, b)
            return a.score > b.score
        end
    )

    local result = {}

    for i = 1,
        math.min(
            #scored,
            CONFIG.Brain.MaxRetrievedMemories
        ) do

        table.insert(
            result,
            scored[i].item
        )

    end

    return result
end

local function retrievedMemoryText(query)

    local memories =
        retrieveMemories(query)

    local result = {}

    for _, item in ipairs(memories) do

        table.insert(
            result,
            string.format(
                "[%s] %s",
                item.category,
                item.text
            )
        )

    end

    return table.concat(result, "\n")
end

