local function stopMovement()
    Agent.PathId += 1
    Agent.Moving = false
    Agent.CurrentGoal = nil
    if Agent.CloneHumanoid then
        pcall(function() Agent.CloneHumanoid:Move(Vector3.zero) end)
    end
end

local function teleportToPlayer()
    if not Agent.Root or not Agent.Clone then return end
    local target = Agent.Root.CFrame * CFrame.new(0, 0, CONFIG.Agent.FollowDistance)
    pcall(function() Agent.Clone:PivotTo(target) end)
end

local function navigate(destination)
    if not Agent.CloneRoot or not Agent.CloneHumanoid or not destination then return false end

    Agent.PathId += 1
    local id = Agent.PathId
    Agent.Moving = true
    Agent.CurrentGoal = destination

    local path
    local ok = pcall(function()
        path = PathfindingService:CreatePath({
            AgentRadius = CONFIG.Movement.AgentRadius,
            AgentHeight = CONFIG.Movement.AgentHeight,
            AgentCanJump = CONFIG.Movement.AgentCanJump,
            AgentCanClimb = CONFIG.Movement.AgentCanClimb,
            WaypointSpacing = CONFIG.Movement.WaypointSpacing
        })
        path:ComputeAsync(Agent.CloneRoot.Position, destination)
    end)

    if not ok or not path or path.Status \~= Enum.PathStatus.Success then
        Agent.Moving = false
        pcall(function() Agent.CloneHumanoid:MoveTo(destination) end)
        return false
    end

    local waypoints = path:GetWaypoints()
    for _, waypoint in ipairs(waypoints) do
        if not Agent.Alive or id \~= Agent.PathId then break end
        if waypoint.Action == Enum.PathWaypointAction.Jump then
            Agent.CloneHumanoid.Jump = true
        end
        pcall(function() Agent.CloneHumanoid:MoveTo(waypoint.Position) end)

        local reached = false
        local connection = Agent.CloneHumanoid.MoveToFinished:Connect(function(success)
            reached = success
        end)

        local started = tick()
        while tick() - started < 2.5 do
            if not Agent.Alive or id \~= Agent.PathId or not Agent.CloneRoot then break end
            if (Agent.CloneRoot.Position - waypoint.Position).Magnitude < 3 then
                reached = true
                break
            end
            if reached then break end
            task.wait(0.08)
        end
        if connection then connection:Disconnect() end
        if not reached then break end
    end

    if id == Agent.PathId then Agent.Moving = false end
    return true
end

local function follow()
    if not Agent.Root or not Agent.CloneRoot then return end
    local d = dist(Agent.CloneRoot, Agent.Root)

    if d > CONFIG.Agent.TeleportDistance then
        remember("navigation", "AI was too far away and returned.")
        thoughtBubble("Tôi đi hơi xa. Tôi sẽ quay lại.")
        teleportToPlayer()
        return
    end

    if d <= CONFIG.Agent.StopDistance then
        stopMovement()
        return
    end

    if tick() - Agent.LastPath < CONFIG.Movement.Recalculate then return end
    Agent.LastPath = tick()

    local target = Agent.Root.Position - Agent.Root.CFrame.LookVector * CONFIG.Agent.FollowDistance
    task.spawn(function() navigate(target) end)
end

--==================================================
-- COMMAND SYSTEM
--==================================================

local function setLanguage(language)
    if not language or language == "" then return "Ngôn ngữ không hợp lệ." end
    CONFIG.Agent.Language = language
    remember("preference", "Language = " .. language)
    return "Đã đổi ngôn ngữ AI sang: " .. language
end

local function setPersonality(text)
    CONFIG.Agent.Personality = tostring(text)
    remember("preference", "Personality = " .. text)
    return "Đã thay đổi tính cách."
end

local function setStyle(text)
    CONFIG.Agent.Style = tostring(text)
    remember("preference", "Style = " .. text)
    return "Đã thay đổi phong cách trả lời."
end

local function createCustomSkill(name, description, instructions)
    name = string.lower(tostring(name or ""))
    if name == "" then return false end
    registerSkill(name, description or "Custom skill", {}, instructions or "")
    remember("skill", "Created skill: " .. name)
    return true
end

local function profileText()
    local skillCount = 0
    for _ in pairs(Agent.Skills) do skillCount += 1 end
    return table.concat({
        "Name: " .. CONFIG.Agent.Name,
        "Language: " .. CONFIG.Agent.Language,
        "Personality: " .. CONFIG.Agent.Personality,
        "Style: " .. CONFIG.Agent.Style,
        "Initiative: " .. tostring(CONFIG.Agent.Initiative),
        "Creativity: " .. tostring(CONFIG.Agent.Creativity),
        "Memory: " .. tostring(#Agent.Memory),
        "Skills: " .. tostring(skillCount),
        "BrainId: " .. tostring(Agent.BrainId)
    }, "\n")
end

local function command(message)
    if string.sub(message, 1, 1) \~= "/" then return nil end

    local args = {}
    for word in string.gmatch(message, "%S+") do
        table.insert(args, word)
    end
    local cmd = string.lower(args[1] or "")

    if cmd == "/language" then
        return setLanguage(table.concat(args, " ", 2))
    end
    if cmd == "/personality" then
        return setPersonality(table.concat(args, " ", 2))
    end
    if cmd == "/style" then
        return setStyle(table.concat(args, " ", 2))
    end
    if cmd == "/instruction" or cmd == "/instructions" then
        addInstruction(table.concat(args, " ", 2))
        return "Đã thêm personal instruction."
    end
    if cmd == "/profile" then
        return profileText()
    end
    if cmd == "/memory" then
        return memoryText(60)
    end
    if cmd == "/skills" or cmd == "/skill" then
        if args[2] == "list" or not args[2] then
            local list = {}
            for name, skill in pairs(Agent.Skills) do
                table.insert(list, name .. " — " .. skill.Description)
            end
            table.sort(list)
            return table.concat(list, "\n")
        end
        if args[2] == "use" then
            local skill = Agent.Skills[string.lower(args[3] or "")]
            if not skill then return "Không tìm thấy skill." end
            remember("skill", "Activated: " .. skill.Name)
            return "Đã kích hoạt skill: " .. skill.Name .. "\n" .. skill.Instructions
        end
        if args[2] == "create" then
            local name = args[3]
            local description = table.concat(args, " ", 4)
            if not name then return "Dùng: /skill create ten mo-ta" end
            createCustomSkill(name, description, description)
            return "Đã tạo skill: " .. name
        end
    end
    if cmd == "/follow" then
        Agent.Following = true
        return "Đã bật follow."
    end
    if cmd == "/stop" then
        Agent.Following = false
        stopMovement()
        return "Đã dừng follow."
    end
    if cmd == "/scan" then
        scanWorld()
        return observationText()
    end
    if cmd == "/reset" then
        table.clear(Agent.Memory)
        table.clear(Agent.Conversation)
        return "Đã reset memory và conversation."
    end
    if cmd == "/brainid" then
        return "BrainId: " .. tostring(Agent.BrainId)
    end
    return "Command không tồn tại."
end

--==================================================
-- LOCAL BRAIN
--==================================================

local function localBrain(message)
    local lower = string.lower(message)

    if lower:find("theo anh", 1, true) or lower:find("follow", 1, true) then
        Agent.Following = true
        return "Được. Tôi sẽ theo anh và tự tìm đường."
    end
    if lower:find("dừng", 1, true) or lower:find("stop", 1, true) then
        Agent.Following = false
        stopMovement()
        return "Đã dừng. Tôi vẫn có thể quan sát."
    end
    if lower:find("quét", 1, true) or lower:find("scan", 1, true) or lower:find("quan sát", 1, true) then
        scanWorld()
        return "Đây là những gì tôi quan sát được:\n" .. observationText()
    end
    if lower:find("skill", 1, true) then
        local skill = selectSkill(message)
        if skill then
            return "Skill phù hợp: " .. skill.Name .. "\n" .. skill.Instructions
        end
    end
    if lower:find("bạn là ai", 1, true) then
        return "Tôi là " .. CONFIG.Agent.Name .. ", một adaptive AI companion. Tôi có memory, skills, observation, navigation và personality."
    end
    if lower:find("nhận xét", 1, true) or lower:find("comment", 1, true) then
        scanWorld()
        return "Nhận xét hiện tại:\n" .. observationText()
    end
    if lower:find("nhớ", 1, true) then
        return "Tôi đang giữ " .. tostring(#Agent.Memory) .. " memory entries."
    end

    local skill = selectSkill(message)
    if skill then
        remember("skill", "Used skill: " .. skill.Name)
        return "Tôi sẽ xử lý yêu cầu bằng skill \"" .. skill.Name .. "\".\n\n" .. skill.Instructions
    end

    return "Tôi đã nhận yêu cầu: \"" .. clampText(message, 180) .. "\".\nTôi đang sử dụng dữ liệu quan sát, memory và các skill phù hợp để xử lý."
end

--==================================================
-- REMOTE BRAIN
--==================================================

local function extractResponse(data)
    if type(data) \~= "table" then return nil end
    local candidates = { data.response, data.answer, data.reply, data.content, data.text }
    for _, value in ipairs(candidates) do
        if type(value) == "string" and #value > 0 then return value end
    end
    if type(data.message) == "string" then return data.message end
    if type(data.message) == "table" and type(data.message.content) == "string" then
        return data.message.content
    end
    if type(data.choices) == "table" and data.choices[1] then
        local choice = data.choices[1]
        if type(choice.message) == "table" and type(choice.message.content) == "string" then
            return choice.message.content
        end
        if type(choice.text) == "string" then return choice.text end
    end
    return nil
end

local function buildPrompt(message)
    local skill = selectSkill(message)
    local skillText = ""
    if skill then
        skillText = "\nACTIVE SKILL:\n" .. skill.Name .. "\n" .. skill.Instructions
    end
    local instructions = table.concat(Agent.Instructions, "\n")

    local prompt = [[
You are an adaptive AI companion inside Roblox.

IDENTITY:
Name: ]] .. CONFIG.Agent.Name .. [[

LANGUAGE:
]] .. CONFIG.Agent.Language .. [[

PERSONALITY:
]] .. CONFIG.Agent.Personality .. [[

STYLE:
]] .. CONFIG.Agent.Style .. [[

INITIATIVE:
]] .. tostring(CONFIG.Agent.Initiative) .. [[

CREATIVITY:
]] .. tostring(CONFIG.Agent.Creativity) .. [[

PERSONAL INSTRUCTIONS:
]] .. instructions .. [[

SKILL:
]] .. skillText .. [[

WORLD OBSERVATIONS:
]] .. observationText() .. [[

MEMORY:
]] .. memoryText(50) .. [[

RULES:
- Never invent world observations.
- Distinguish facts from assumptions.
- Adapt when new information arrives.
- Use memory when useful.
- If information is missing, say so.
- Give practical answers.
- Do not claim to have performed an action unless a Roblox tool actually performed it.
- You may suggest actions, but the client must execute them.

USER:
]] .. message

    if #prompt > CONFIG.Remote.MaxContext then
        prompt = string.sub(prompt, #prompt - CONFIG.Remote.MaxContext)
    end
    return prompt
end

local function remoteBrain(message)
    if not CONFIG.Remote.Enabled or not HTTP then return nil end
    if tick() - Agent.LastRemote < 1 then return nil end
    Agent.LastRemote = tick()

    local prompt = buildPrompt(message)
    local body = {
        message = prompt,
        prompt = prompt,
        user = LocalPlayer.Name,
        system = "Adaptive Roblox AI Agent",
        conversation = Agent.Conversation
    }

    local encoded
    local encodedOK = pcall(function()
        encoded = HttpService:JSONEncode(body)
    end)
    if not encodedOK then return nil end

    for _, endpoint in ipairs(CONFIG.Remote.Endpoints) do
        local response
        local ok = pcall(function()
            response = HTTP({
                Url = CONFIG.Remote.BaseURL .. endpoint,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = encoded
            })
        end)

        if ok and type(response) == "table" and tonumber(response.StatusCode)
            and response.StatusCode >= 200 and response.StatusCode < 300 then

            local data
            local decodeOK = pcall(function()
                data = HttpService:JSONDecode(response.Body)
            end)
            if decodeOK then
                local result = extractResponse(data)
                if result then
                    Agent.RemoteAvailable = true
                    return result
                end
            end
        end
    end

    Agent.RemoteAvailable = false
    return nil
end

--==================================================
-- CHAT
--==================================================

local function respond(message)
    if Agent.BrainBusy then return end
    Agent.BrainBusy = true

    addMessage("Anh", message, Color3.fromRGB(220, 220, 220))
    table.insert(Agent.Conversation, { role = "user", content = message })
    while #Agent.Conversation > CONFIG.Agent.ConversationLimit do
        table.remove(Agent.Conversation, 1)
    end

    task.spawn(function()
        local commandResult = command(message)
        local response

        if commandResult then
            response = commandResult
        else
            response = remoteBrain(message)
            if not response then
                response = localBrain(message)
            end
        end

        if not response then
            response = "Tôi chưa có đủ dữ liệu."
        end

        table.insert(Agent.Conversation, { role = "assistant", content = response })
        while #Agent.Conversation > CONFIG.Agent.ConversationLimit do
            table.remove(Agent.Conversation, 1)
        end

        remember("conversation", "User: " .. clampText(message, 120))
        remember("conversation", "AI: " .. clampText(response, 180))

        addMessage(CONFIG.Agent.Name, response, Color3.fromRGB(120, 180, 255))
        thoughtBubble(response)
        Agent.BrainBusy = false
    end)
end

