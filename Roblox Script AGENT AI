-- SKILL SELECTION
--============================================================

local function selectSkill(message)

    local lower =
        normalize(message)

    local best = nil

    local bestScore = 0

    for _, skill in pairs(Agent.Skills) do

        local score = 0

        for _, trigger in ipairs(skill.Triggers) do

            if string.find(
                lower,
                normalize(trigger),
                1,
                true
            ) then

                score += 1
            end
        end

        if score > bestScore then

            bestScore = score

            best = skill

        end
    end

    return best, bestScore
end

